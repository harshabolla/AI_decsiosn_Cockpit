# =============================================================================
# Opella AI Decision Cockpit — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# NEVER print or log API keys.
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-256-bit-secret
CORS_ORIGINS=http://localhost:3000

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Use either GOOGLE_API_KEY or GEMINI_API_KEY (both are checked)
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# ── xAI Grok ──────────────────────────────────────────────────────────────────
XAI_API_KEY=
GROK_DEFAULT_MODEL=grok-beta

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── Default LLM Routing ───────────────────────────────────────────────────────
# Primary provider: openai | anthropic | gemini | grok | bedrock
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o

# ── Task-Specific Routing ─────────────────────────────────────────────────────
# Override provider/model for each task type.
# Leave empty to use DEFAULT_LLM_PROVIDER / DEFAULT_LLM_MODEL.
#
# Intent classification (low-latency preferred)
INTENT_PROVIDER=
INTENT_MODEL=

# SQL generation (strong structured-output model preferred)
SQL_PROVIDER=
SQL_MODEL=

# RAG synthesis (strong reasoning model preferred)
RAG_PROVIDER=
RAG_MODEL=

# Independent reviewer (different provider for cross-checking)
REVIEWER_PROVIDER=
REVIEWER_MODEL=

# Fast tasks (summary, visualization spec)
FAST_PROVIDER=
FAST_MODEL=

# ── Fallback Chain ────────────────────────────────────────────────────────────
# Comma-separated list of providers to try if primary fails.
# Example: LLM_FALLBACK_CHAIN=anthropic,gemini,grok
LLM_FALLBACK_CHAIN=
LLM_FALLBACK_PROVIDER=openai

# ── Snowflake ─────────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
# Set to "local" to use the DuckDB local demo adapter
WAREHOUSE_ADAPTER=local

# ── Vector Store ──────────────────────────────────────────────────────────────
# local = in-memory TF store (no dependencies, development)
# chroma = ChromaDB with real embeddings
VECTOR_STORE=local
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=opella_knowledge

# ── ServiceNow ────────────────────────────────────────────────────────────────
SERVICENOW_INSTANCE=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
# Set to "mock" to use the local mock adapter
SERVICENOW_ADAPTER=mock

# ── Security ──────────────────────────────────────────────────────────────────
PII_DETECTION_ENABLED=true
PROMPT_INJECTION_DETECTION_ENABLED=true
DLP_ENABLED=true

# ── Memory ────────────────────────────────────────────────────────────────────
CONVERSATION_MEMORY_ENABLED=true
CONVERSATION_MEMORY_MAX_TURNS=10

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENABLE_REQUEST_LOGGING=true

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
